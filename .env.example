# ElevenLabs API credentials for automated voice generation
# Get your key at https://elevenlabs.io → Profile + API Key
ELEVENLABS_API_KEY=your_api_key_here

# ElevenLabs voice ID (find it in the VoiceLab or use the API)
# Default "Adam" (pNInz6obpgDQGcFmaJgB) is a steady male narrator.
# For a different voice, paste its ID here.
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB

# Remotion temp directory — point this at a drive with ≥100 GB free space.
# Every Remotion bundle copies public/ (~1.3 GB) here and never cleans up.
# On macOS: /Volumes/BigDrive/remotion-tmp
# On Linux: /mnt/data/remotion-tmp
REMOTION_TMP=/tmp/remotion-tmp

# Speaking speed 0.7-1.2 (default 1.15: stock voices run ~2.8 words/s at 1.0, the style needs ~3.2-3.7)
# ELEVENLABS_SPEED=1.15
